# =====================================================================
# ecommerce-microservices-uce - Configuration template
# Copy this file to ".env" and replace every "change_me" value.
# NEVER commit the real ".env" file.
# Variable names may be extended as each service is implemented.
# =====================================================================

# --- Gateway ---------------------------------------------------------
# Only port published on the host machine
GATEWAY_PORT=8080

# --- PostgreSQL (superuser, used ONLY by the init script) ------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_superuser

# --- One database and one role per microservice -----------------------
USER_DB_NAME=users_db
USER_DB_USER=user_svc
USER_DB_PASSWORD=change_me_user_db

PRODUCT_DB_NAME=products_db
PRODUCT_DB_USER=product_svc
PRODUCT_DB_PASSWORD=change_me_product_db

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_svc
INVENTORY_DB_PASSWORD=change_me_inventory_db

ORDER_DB_NAME=orders_db
ORDER_DB_USER=order_svc
ORDER_DB_PASSWORD=change_me_order_db

PAYMENT_DB_NAME=payments_db
PAYMENT_DB_USER=payment_svc
PAYMENT_DB_PASSWORD=change_me_payment_db

NOTIFICATION_DB_NAME=notifications_db
NOTIFICATION_DB_USER=notification_svc
NOTIFICATION_DB_PASSWORD=change_me_notification_db

# --- JWT (RS256) -------------------------------------------------------
# Keys are NOT stored here: they are generated locally into "secrets/"
# and mounted as Docker Compose secrets.
JWT_ALGORITHM=RS256
JWT_ISSUER=user-service
JWT_AUDIENCE=ecommerce-uce
JWT_EXPIRE_MINUTES=30

# --- Service-to-service authentication -------------------------------
# Shared key required by /internal endpoints
INTERNAL_API_KEY=change_me_internal_api_key

# --- Initial administrator (created by the user-service migration job) -
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# --- HTTP calls between services (seconds) ----------------------------
HTTP_CONNECT_TIMEOUT_SECONDS=2
HTTP_READ_TIMEOUT_SECONDS=5

# --- Orders: reservation and recovery (minutes) -----------------------
ORDER_RESERVATION_TTL_MINUTES=15
RESERVING_SWEEP_MINUTES=2

# --- Reconciliation worker (order-service) ----------------------------
WORKER_POLL_SECONDS=5
WORKER_MAX_FAST_ATTEMPTS=10
WORKER_BACKOFF_MAX_SECONDS=300
# Slow lane for FAILED transient operations (900 = 15 min; use 60 for demos)
WORKER_SLOW_RETRY_SECONDS=900
# A claimed operation not finished in this time can be taken by another
# worker. Must cover the slowest HTTP call (2 x connect + read timeouts) twice.
WORKER_LEASE_SECONDS=60

# --- Payment simulation (payment-service) -----------------------------
PAYMENT_SIMULATION_ENABLED=true
PAYMENT_SLOW_DELAY_SECONDS=8

# --- Logging ---------------------------------------------------------
LOG_LEVEL=INFO

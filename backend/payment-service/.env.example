# Variables to run payment-service on your PC (outside Docker).
# Copy to ".env" in this folder. Inside Docker, Compose sets these values.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=payments_db
DB_USER=payment_svc
DB_PASSWORD=change_me_same_as_PAYMENT_DB_PASSWORD_in_root_env

# Only the PUBLIC key: this service verifies tokens but never issues them
JWT_PUBLIC_KEY_PATH=../../secrets/jwt_public.pem

# Key for calls between services (same value as in the root .env)
INTERNAL_API_KEY=change_me_same_as_INTERNAL_API_KEY_in_root_env

# Simulated payments. Disabled unless set to true explicitly.
PAYMENT_SIMULATION_ENABLED=true
PAYMENT_SLOW_DELAY_SECONDS=8

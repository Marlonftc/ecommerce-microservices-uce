# Variables to run user-service on your PC (outside Docker).
# Copy to ".env" in this folder. Inside Docker, Compose sets these values.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=users_db
DB_USER=user_svc
DB_PASSWORD=change_me_same_as_USER_DB_PASSWORD_in_root_env

# Initial administrator (same values as in the root .env)
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_PASSWORD=change_me_same_as_ADMIN_PASSWORD_in_root_env
ADMIN_NAME=Administrador

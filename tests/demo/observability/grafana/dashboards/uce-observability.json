    {
      "id": 21,
      "title": "Tiempo de respuesta · readiness de los seis servicios",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "uce-prometheus"
      },
      "description": "Duración completa de la sonda (DNS, conexión y respuesta), en ms. No es tráfico de usuarios ni k6; los fallos completados pueden incluir el timeout.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "decimals": 1,
          "noValue": "Sin medición",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 4
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "uce-prometheus"
          },
          "expr": "1000 * (probe_duration_seconds{job=\"blackbox\",probe=\"ready\"} and on(job,instance) uce:probe_success:fresh)",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{component}}",
          "editorMode": "code"
        }
      ]
    },
